<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login · Monitoring IoT</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        hijau: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d'
                        }
                    }
                }
            }
        }
    </script>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <script>
        function toggleTheme() {
            const root = document.documentElement;
            const isDark = root.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        }
    </script>
</head>

<body class="min-h-screen bg-[#f5f8f3] dark:bg-[#0c1210] text-gray-800 dark:text-gray-200 antialiased flex items-center justify-center px-6 py-12 transition-colors duration-200">

    <button onclick="toggleTheme()"
        class="fixed top-5 right-5 inline-flex items-center justify-center w-10 h-10 rounded-full text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        title="Ganti tema">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
    </button>

    <div class="w-full max-w-sm">

        <div class="flex flex-col items-center mb-8">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-hijau-400 to-hijau-600 flex items-center justify-center shadow-lg shadow-hijau-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6-5.686-6-10a6 6 0 1 1 12 0c0 4.314-6 10-6 10z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 10h6" />
                </svg>
            </div>
            <h1 class="mt-4 text-xl font-semibold text-gray-900 dark:text-gray-100">Hidroponik</h1>
            <p class="text-sm text-gray-400 dark:text-gray-500 mt-0.5">Masuk untuk memantau dan mengontrol</p>
        </div>

        <div class="bg-white dark:bg-[#151d19] rounded-2xl border border-gray-200/70 dark:border-gray-800 shadow-sm p-8">

            <% if (error) { %>
                <div class="mb-6 flex items-center gap-2 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-100 dark:border-red-800 px-4 py-3 text-sm text-red-600 dark:text-red-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                    </svg>
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                <div>
                    <label for="username" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1.5">Username</label>
                    <input type="text" id="username" name="username" required autofocus placeholder="admin"
                        class="w-full rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 px-4 py-3 text-sm text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-hijau-300 focus:border-hijau-300 transition-shadow">
                </div>
                <div>
                    <label for="password" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1.5">Password</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••"
                        class="w-full rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 px-4 py-3 text-sm text-gray-800 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-hijau-300 focus:border-hijau-300 transition-shadow">
                </div>
                <button type="submit"
                    class="w-full flex items-center justify-center gap-2 rounded-xl bg-hijau-500 hover:bg-hijau-600 active:bg-hijau-700 text-white text-sm font-medium py-3 transition-colors duration-150 shadow-sm shadow-hijau-200 focus:outline-none focus:ring-2 focus:ring-hijau-300 focus:ring-offset-2 dark:focus:ring-offset-[#151d19]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                    </svg>
                    Masuk
                </button>
            </form>

        </div>

        <p class="mt-8 text-center text-xs text-gray-400 dark:text-gray-500">Monitoring Hidroponik · Sistem IoT</p>
    </div>

</body>

</html>